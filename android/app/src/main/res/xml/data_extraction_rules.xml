<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. allowBackup="false" stops cloud backups, but not
     device-to-device transfer, so the saved keys are excluded here too. Their
     Keystore key stays on the old phone, so they could never be decrypted. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
